# The edge, inside Kubernetes. Static host, reverse proxy and API gateway.
#
# Compare this with infra/nginx/default.conf.template line for line. That file
# needs
#
#     resolver 127.0.0.11 valid=2s;
#     set $api_upstream http://api:5001;
#     proxy_pass $api_upstream;
#
# because in compose `api` resolved to container IPs that changed whenever a
# replica came or went, and nginx resolves a literal upstream exactly once at
# start-up. The variable forced a re-lookup; the re-lookup was the balancing.
#
# Here the literal is correct again, and it is the better of the two:
#
#   · `api` resolves to a ClusterIP that is stable for the life of the
#     Service, so there is nothing to re-resolve and no TTL to tune.
#   · kube-proxy holds the ready pods behind that address and picks one per
#     connection, so the granularity is a connection rather than a 2s window.
#   · readiness is part of it. A pod whose /api/health says 503 is removed
#     from the endpoint set, so it stops receiving traffic - something DNS
#     round-robin cannot express at all.
#
# Note what is absent: no `upstream` block and so no `keepalive`. nginx opens
# a connection per proxied request here, and since the Service balances per
# connection, that is what makes consecutive requests actually spread. An
# upstream keepalive pool would pin a reused connection to one pod and quietly
# undo it - the same class of mistake as the resolver TTL, one layer up.
#
# The literal also removes two traps the compose edge has to work around, and
# both are worth knowing because they only exist when the upstream is a
# variable: proxy_pass to a variable does no URI rewriting, so a trailing
# slash silently fails to strip a prefix; and the `rewrite ... break` needed
# instead will skip any `set` written after it. Here `proxy_pass
# http://auth:5002/` strips /api/auth/ by itself, as the documentation says it
# should.
#
# A .template, not a .conf, because the edge authenticates now and the secret
# it presents must come from the Secret rather than the image. See the note in
# client/Dockerfile.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---- the gateway's error shape ------------------------------------------
    #
    # auth_request refusals are nginx's own HTML pages by default. The project
    # has one error shape everywhere, and the point of a gateway is that a
    # client cannot tell which process answered - so a refusal from the edge
    # has to look like a refusal from a service.
    error_page 401 = @unauthorized;
    error_page 403 = @forbidden;

    location @unauthorized {
        internal;
        default_type application/json;
        return 401 '{"error":{"code":"UNAUTHORIZED","message":"Authentication required","requestId":"$request_id"}}';
    }

    location @forbidden {
        internal;
        default_type application/json;
        return 403 '{"error":{"code":"FORBIDDEN","message":"You do not have access to this resource","requestId":"$request_id"}}';
    }

    # ---- the authentication subrequest --------------------------------------
    #
    # `internal`, so no client can reach it. The body is dropped because
    # introspection reads the Authorization header and nothing else, and
    # Content-Length has to be cleared with it or the upstream waits for a
    # body that never arrives.
    #
    # nginx issues this as a GET whatever the original request was, which is
    # why the auth service answers GET here as well as POST.
    location = /_authn {
        internal;
        proxy_pass http://auth:5002/internal/introspect;

        proxy_http_version 1.1;
        proxy_pass_request_body off;
        proxy_set_header Content-Length   "";
        proxy_set_header Authorization    $http_authorization;
        proxy_set_header X-Gateway-Key    "${AUTH_GATEWAY_SECRET}";
        proxy_set_header X-Request-ID     $request_id;

        # Short on purpose. This is on the path of every API request, so a
        # slow auth service must fail rather than hold the whole portal.
        proxy_connect_timeout 2s;
        proxy_read_timeout    2s;
    }

    # ---- routing ------------------------------------------------------------

    # Neither service's internal surface is reachable from outside. Both check
    # the shared secret themselves as well; this is the outer of two locks,
    # and 404 is what they answer so the edge reveals no more than they would.
    location /api/internal/ {
        return 404 '{"error":{"code":"NOT_FOUND","message":"Not found"}}';
    }
    location /api/auth/internal/ {
        return 404 '{"error":{"code":"NOT_FOUND","message":"Not found"}}';
    }

    # Authentication, to the auth service, with the /api/auth prefix stripped
    # by the trailing slash. No auth_request - these are the routes that exist
    # to get a token, so requiring one would be circular.
    #
    # The identity headers are cleared rather than left alone: nginx passes
    # through any header it does not set, so without these a client could send
    # its own x-auth-user-id and have it arrive at an upstream.
    location /api/auth/ {
        proxy_pass http://auth:5002/;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID      $request_id;

        proxy_set_header X-Auth-User-Id    "";
        proxy_set_header X-Auth-User-Role  "";
        proxy_set_header X-Auth-User-Email "";
        proxy_set_header X-Gateway-Key     "";

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    # The inbox, to the notifications service, with the prefix stripped by the
    # trailing slash. auth_request applies here as it does to /api/: these are
    # a user's own notifications.
    location /api/notifications/ {
        auth_request /_authn;
        auth_request_set $auth_user_id    $upstream_http_x_auth_user_id;
        auth_request_set $auth_user_role  $upstream_http_x_auth_user_role;
        auth_request_set $auth_user_email $upstream_http_x_auth_user_email;

        proxy_pass http://notifications:5003/;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID      $request_id;

        proxy_set_header X-Auth-User-Id    $auth_user_id;
        proxy_set_header X-Auth-User-Role  $auth_user_role;
        proxy_set_header X-Auth-User-Email $auth_user_email;
        proxy_set_header X-Gateway-Key     "${AUTH_GATEWAY_SECRET}";

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    # The bare prefix, which the client also uses, needs its own exact match or
    # it falls through to /api/ and reaches the API, which no longer has it.
    location = /api/notifications {
        auth_request /_authn;
        auth_request_set $auth_user_id    $upstream_http_x_auth_user_id;
        auth_request_set $auth_user_role  $upstream_http_x_auth_user_role;
        auth_request_set $auth_user_email $upstream_http_x_auth_user_email;

        proxy_pass http://notifications:5003/;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Request-ID      $request_id;
        proxy_set_header X-Auth-User-Id    $auth_user_id;
        proxy_set_header X-Auth-User-Role  $auth_user_role;
        proxy_set_header X-Auth-User-Email $auth_user_email;
        proxy_set_header X-Gateway-Key     "${AUTH_GATEWAY_SECRET}";
    }

    # The two health endpoints are deliberately open - whether the portal and
    # the model are working is operational information and reveals nothing
    # about any person. Exact matches, so they are carved out of /api/ below
    # without opening anything else.
    #
    # /api/health is also the API's readiness probe target, but a probe reaches
    # the pod directly and never passes through here.
    location = /api/health {
        proxy_pass http://api:5001;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Request-ID      $request_id;
        proxy_set_header X-Auth-User-Id    "";
        proxy_set_header X-Auth-User-Role  "";
        proxy_set_header X-Auth-User-Email "";
        proxy_set_header X-Gateway-Key     "";

        add_header X-Upstream-Addr $upstream_addr always;
    }

    location = /api/ai/health {
        proxy_pass http://api:5001;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Request-ID      $request_id;
        proxy_set_header X-Auth-User-Id    "";
        proxy_set_header X-Auth-User-Role  "";
        proxy_set_header X-Auth-User-Email "";
        proxy_set_header X-Gateway-Key     "";
    }

    # Everything else under /api is the API, authenticated here first.
    #
    # auth_request fires the subrequest above; a 2xx lets the request through
    # and a 401 or 403 ends it with the JSON above. auth_request_set then lifts
    # the identity out of the subrequest's *response headers* - the only part
    # of a subrequest response nginx keeps, which is why introspection returns
    # the identity in headers as well as in its body.
    #
    # The API then trusts those headers, because IDENTITY_MODE=gateway and the
    # proof secret says they came from here. It verifies no token and reads no
    # user: that happened once, in the service that owns the data.
    location /api/ {
        auth_request /_authn;
        auth_request_set $auth_user_id    $upstream_http_x_auth_user_id;
        auth_request_set $auth_user_role  $upstream_http_x_auth_user_role;
        auth_request_set $auth_user_email $upstream_http_x_auth_user_email;

        proxy_pass http://api:5001;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID      $request_id;

        # Always set, never passed through: whatever the client sent under
        # these names is replaced by what the auth service said.
        proxy_set_header X-Auth-User-Id    $auth_user_id;
        proxy_set_header X-Auth-User-Role  $auth_user_role;
        proxy_set_header X-Auth-User-Email $auth_user_email;
        proxy_set_header X-Gateway-Key     "${AUTH_GATEWAY_SECRET}";

        # Kept for symmetry with the compose edge, but read it carefully: here
        # it reports the Service's ClusterIP on every single request, never a
        # pod address.
        #
        # That is not a defect, it is the mechanism showing through. nginx
        # opens a connection to one virtual address; kube-proxy rewrites the
        # destination in the kernel and picks a pod. nginx is not consulted
        # and is never told, so $upstream_addr is all it can honestly report.
        # In compose nginx *was* the balancer, so the same variable named a
        # container - the header got less informative precisely because the
        # balancing moved somewhere better.
        #
        # Which pod answered now comes from the pod: /api/health returns an
        # `instance` field, which is os.hostname() and therefore the pod name.
        add_header X-Upstream-Addr $upstream_addr always;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    # No auth_request, and now a service of its own.
    #
    # A handshake carries its token in the Socket.IO connection payload rather
    # than an Authorization header, and there is no subrequest to run on a
    # websocket upgrade anyway - so this is the one entry point the gateway
    # cannot authenticate. The service that holds the socket introspects the
    # token against the auth service itself, which since the realtime
    # extraction is `realtime` rather than the API. The API held it before
    # only because it hosted the HTTP server.
    location /socket.io/ {
        proxy_pass http://realtime:5004;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Request-ID $request_id;

        proxy_set_header X-Auth-User-Id    "";
        proxy_set_header X-Auth-User-Role  "";
        proxy_set_header X-Auth-User-Email "";
        proxy_set_header X-Gateway-Key     "";

        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
