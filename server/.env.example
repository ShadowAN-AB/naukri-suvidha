# ---- runtime ----
NODE_ENV=development
PORT=5001
LOG_LEVEL=debug
CLIENT_ORIGIN=http://localhost:5173

# ---- database ----
# MongoDB Atlas connection string, or mongodb://127.0.0.1:27017/nexus locally
MONGODB_URI=mongodb://127.0.0.1:27017/nexus

# ---- auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# ---- storage (StorageProvider) ----
# local | s3
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# ---- AI (LLMProvider) ----
# ollama | claude
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_CONCURRENCY=2
AI_TASK_MAX_ATTEMPTS=3
AI_TIMEOUT_MS=30000
