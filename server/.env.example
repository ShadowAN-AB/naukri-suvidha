# ---- runtime ----
NODE_ENV=development
PORT=5001
LOG_LEVEL=debug
CLIENT_ORIGIN=http://localhost:5173

# ---- database ----
# MongoDB Atlas connection string, or mongodb://127.0.0.1:27017/naukri_suvidha locally
MONGODB_URI=mongodb://127.0.0.1:27017/naukri_suvidha

# ---- auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# ---- storage (StorageProvider) ----
# local | s3
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# ---- AI (LLMProvider) ----
# ollama | claude
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_CONCURRENCY=2
AI_TASK_MAX_ATTEMPTS=3
AI_TIMEOUT_MS=30000

# ---- S3-compatible storage (only when STORAGE_PROVIDER=s3) ----
# Render's disk is ephemeral, so production must not use local disk.
# Leave S3_ENDPOINT blank for AWS; set it for Cloudflare R2, Backblaze B2 or MinIO.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- semantic search ----
# Vectors from different models are not comparable; changing this invalidates
# every stored embedding. Pull it with: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
# memory = linear scan in process (works anywhere)
# atlas  = $vectorSearch (needs a search index defined on Atlas)
VECTOR_INDEX=memory
