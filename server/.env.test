# Test-only configuration. Committed on purpose: nothing here is a real
# secret, and CI needs it to run the suite without any setup.
#
# The database name MUST contain "test" - the suite refuses to run otherwise,
# because it deletes every collection between tests.
NODE_ENV=test
PORT=5099
LOG_LEVEL=fatal
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/naukri_suvidha_test

# IDENTITY_MODE is left at its default, `bearer`: the suite sends real bearer
# tokens, as a single-process `npm run dev` does. The gateway strategy is
# tested directly in test/gateway.test.js, which needs this secret to exist
# but does not switch the whole app over - env.js is parsed once at import,
# long before any test file body runs, so a per-file override is not possible.
AUTH_GATEWAY_SECRET=test-only-gateway-secret-not-real

JWT_ACCESS_SECRET=test-only-access-secret-not-used-anywhere-real-0000
JWT_REFRESH_SECRET=test-only-refresh-secret-not-used-anywhere-real-000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=10

STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads-test
MAX_UPLOAD_BYTES=5242880

# Port 1 is never listening, so every model call fails fast and the tests
# exercise the deterministic fallback. No test needs a model installed.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:1
OLLAMA_MODEL=test-model
ANTHROPIC_MODEL=claude-opus-5
AI_CONCURRENCY=2
AI_TASK_MAX_ATTEMPTS=2
AI_TIMEOUT_MS=1500

EMBEDDING_MODEL=nomic-embed-text
VECTOR_INDEX=memory
