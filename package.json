{
  "name": "naukri-suvidha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Naukri Suvidha - an AI-assisted campus placement portal",
  "workspaces": [
    "shared",
    "service-kit",
    "server",
    "services/*",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,auth,client -c cyan,yellow,magenta \"npm:dev:server\" \"npm:dev:auth\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "seed": "AUTH_MONGODB_URI=${AUTH_MONGODB_URI:-mongodb://127.0.0.1:27017/naukri_suvidha_auth} node server/scripts/seed.js",
    "lint": "eslint .",
    "test": "npm run test:api && npm run test:auth",
    "seed:fresh": "npm run seed -- --fresh",
    "resumes:check": "node server/scripts/check-resumes.js",
    "lint:fix": "eslint . --fix",
    "start": "npm start --workspace=server",
    "seed:resumes": "node server/scripts/seed-resumes.js",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api edge",
    "docker:seed": "docker compose --profile tools run --rm seed",
    "docker:scale": "docker compose up -d --no-recreate --scale api=3",
    "docker:ps": "docker compose ps",
    "k8s:up": "bash infra/k8s/up.sh",
    "k8s:down": "bash infra/k8s/down.sh",
    "k8s:seed": "bash infra/k8s/seed.sh",
    "k8s:ps": "kubectl -n naukri-suvidha get pods,svc,hpa -o wide",
    "k8s:logs": "kubectl -n naukri-suvidha logs -l app.kubernetes.io/name=api --tail=50 -f --max-log-requests=8",
    "k8s:hpa": "kubectl -n naukri-suvidha get hpa api --watch",
    "k8s:load": "bash infra/k8s/load.sh",
    "docs:check": "node server/scripts/check-design-doc.js",
    "dev:auth": "npm run dev --workspace=@naukri-suvidha/auth-service",
    "test:api": "npm run test --workspace=server",
    "test:auth": "npm run test --workspace=@naukri-suvidha/auth-service"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
