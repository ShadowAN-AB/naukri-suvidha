{
  "name": "naukri-suvidha",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus - an AI-assisted campus placement portal",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "seed": "node server/scripts/seed.js",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed:fresh": "node server/scripts/seed.js --fresh",
    "resumes:check": "node server/scripts/check-resumes.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
