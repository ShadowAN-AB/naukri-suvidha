# Test-only configuration. Committed on purpose: nothing here is a real
# secret, and CI needs it to run the suite without any setup.
#
# No MONGODB_URI, and that is not an omission - this service owns no data.
# It is the first suite in the repository that needs no database at all, which
# is also why it has no setup.js dropping collections.
NODE_ENV=test
PORT=5097
LOG_LEVEL=fatal
CLIENT_ORIGIN=http://localhost:5173

# The same secrets the other three carry. They have to match: the auth service
# signs the access tokens this service verifies in bearer mode, and a handshake
# is verified exactly like a request.
JWT_ACCESS_SECRET=test-only-access-secret-not-used-anywhere-real-0000
JWT_REFRESH_SECRET=test-only-refresh-secret-not-used-anywhere-real-000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=10

AUTH_GATEWAY_SECRET=test-only-gateway-secret-not-real

# Both left unset, deliberately.
#
# AUTH_SERVICE_URL unset is bearer mode, so the suite can mint a token and
# complete a handshake without an auth service to introspect against - the
# gateway path is covered by the gateway's own tests.
#
# REDIS_URL unset means a push from another process cannot arrive, which is
# the degradation /health is asserted to report. Testing the adapter would be
# testing @socket.io/redis-adapter.
# AUTH_SERVICE_URL=
# REDIS_URL=
