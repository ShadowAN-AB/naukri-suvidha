# The realtime service. Copy to .env and fill in.
#
# No MONGODB_URI: this service owns no data. Database-per-service means one
# database per deployable that owns data, and live connections are not data
# that can be persisted anywhere useful.
NODE_ENV=development
PORT=5004
LOG_LEVEL=debug
CLIENT_ORIGIN=http://localhost:5173

# Must be byte-identical to the other services'. A handshake is verified with
# the same access token a request carries.
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-to-a-different-32-character-secret-00
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# Where to introspect a handshake's token. A websocket upgrade cannot carry an
# `auth_request`, so this is the one entry point the edge cannot authenticate
# and this service asks the auth service itself. Unset is bearer mode:
# verify the signature here, with no revocation check.
AUTH_SERVICE_URL=http://localhost:5002
AUTH_SERVICE_TIMEOUT_MS=2000
AUTH_GATEWAY_SECRET=change-me-at-least-16-chars

# NOT optional in any deployment with more than one process. This service holds
# every socket and publishes none of its own content: every push originates in
# the API or the notifications service and arrives through the adapter's
# channel. Without it this service accepts connections and delivers nothing.
#   docker compose up -d redis
REDIS_URL=redis://127.0.0.1:6380
