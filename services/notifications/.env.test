# Test-only configuration. Committed on purpose: nothing here is a real
# secret, and CI needs it to run the suite without any setup.
#
# A third test database, distinct from the API's and the auth service's, so
# all three suites can run at once without wiping each other's rows.
NODE_ENV=test
PORT=5096
LOG_LEVEL=fatal
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/naukri_suvidha_notifications_test

# The same secrets the other two carry. They have to match: the auth service
# signs the access tokens this service verifies in bearer mode.
JWT_ACCESS_SECRET=test-only-access-secret-not-used-anywhere-real-0000
JWT_REFRESH_SECRET=test-only-refresh-secret-not-used-anywhere-real-000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=10

AUTH_GATEWAY_SECRET=test-only-gateway-secret-not-real

# Left unset. The suite calls the handlers directly rather than through a
# broker: what needs testing is that each one acts on its event alone, and a
# Kafka round trip would test kafkajs. REDIS_URL is unset for the same reason -
# the socket push is a nicety, and its absence must not fail a notification.
# KAFKA_BROKERS=
# REDIS_URL=
