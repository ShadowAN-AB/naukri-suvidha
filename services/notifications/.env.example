# The notifications service. Copy to .env and fill in.
NODE_ENV=development
PORT=5003
LOG_LEVEL=debug
CLIENT_ORIGIN=http://localhost:5173

# Its own database. The API cannot read the inbox, and this service cannot
# read applications, jobs or students - which is why the events it consumes
# carry their audience with them.
MONGODB_URI=mongodb://127.0.0.1:27017/naukri_suvidha_notifications

# Must be byte-identical to the other services'.
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-to-a-different-32-character-secret-00
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# Required when IDENTITY_MODE=gateway.
AUTH_GATEWAY_SECRET=change-me-at-least-16-chars

# NOT optional in the way it is for the API. This service is a pure consumer:
# with no broker it serves the inbox and creates nothing, ever. Point it at the
# compose broker's host listener to see notifications in development:
#   docker compose up -d kafka redis
KAFKA_BROKERS=localhost:9094

# Carries socket pushes to whichever API replica holds the user's connection.
# Without it the notification row is still written - the inbox fills, the live
# push does not arrive.
REDIS_URL=redis://127.0.0.1:6380
