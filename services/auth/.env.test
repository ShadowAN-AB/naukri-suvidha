# Test-only configuration. Committed on purpose: nothing here is a real
# secret, and CI needs it to run the suite without any setup.
#
# The database name MUST contain "test" - the suite refuses to run otherwise,
# because it deletes every collection between tests.
#
# It is also a *different* database from the API's, which is the boundary this
# service exists to draw. The two suites can run at the same time without
# either one wiping the other's rows.
NODE_ENV=test
PORT=5098
LOG_LEVEL=fatal
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/naukri_suvidha_auth_test

# The same two secrets the API's .env.test carries. They have to match: this
# service signs the tokens that one verifies, and a test that crossed the
# boundary with mismatched secrets would fail for a reason that looks nothing
# like the cause.
JWT_ACCESS_SECRET=test-only-access-secret-not-used-anywhere-real-0000
JWT_REFRESH_SECRET=test-only-refresh-secret-not-used-anywhere-real-000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=10

AUTH_GATEWAY_SECRET=test-only-gateway-secret-not-real

# The suite starts a stub for the API on this port in beforeAll, and each
# test can make it refuse - which is how the compensation path is tested.
API_INTERNAL_URL=http://127.0.0.1:5097
