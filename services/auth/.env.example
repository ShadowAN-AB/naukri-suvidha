# The auth service. Copy to .env and fill in.
#
# Only needed to run this service directly; `npm run dev` at the repo root
# starts it with the values below already, and both container stacks set these
# from their own config.
NODE_ENV=development
PORT=5002
LOG_LEVEL=debug
CLIENT_ORIGIN=http://localhost:5173

# Its own database, which is the whole point: the API has no connection that
# can read `users` or `refreshTokens`.
MONGODB_URI=mongodb://127.0.0.1:27017/naukri_suvidha_auth

# Must be byte-identical to the API's. This service mints access tokens and
# the API verifies them.
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-to-a-different-32-character-secret-00

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# The shared secret on every internal call in both directions. The API must
# have the same value in AUTH_GATEWAY_SECRET, and so must the edge.
AUTH_GATEWAY_SECRET=change-me-at-least-16-chars

# Where to create the Student or Company row a new account implies. Without
# it, registration refuses rather than writing half an account.
API_INTERNAL_URL=http://127.0.0.1:5001
API_INTERNAL_TIMEOUT_MS=3000

# Optional. Set it and the login and registration counters are shared across
# this service's replicas; without it each process keeps its own, which makes
# the effective limit scale with the replica count.
# REDIS_URL=redis://127.0.0.1:6379
