# Test-only configuration. Committed on purpose: nothing here is a real
# secret, and CI needs it to run the suite without any setup.
#
# A fourth test database, distinct from the other three suites'.
NODE_ENV=test
PORT=5098
LOG_LEVEL=fatal
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/naukri_suvidha_email_test

# Left unset. The suite calls the handler directly rather than through a
# broker, and uses a stub for getUserEmail - a Kafka round trip would test
# kafkajs rather than this service, and the auth service is not in the test
# dependency tree.
# KAFKA_BROKERS=
# AUTH_SERVICE_URL=

AUTH_GATEWAY_SECRET=test-only-gateway-secret-not-real

# SMTP stubs. The suite mocks the transport module, so these values are not
# used by any real send - they just satisfy the env schema which requires
# them for the production path.
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USER=test@example.test
SMTP_PASS=not-a-real-password
MAIL_FROM="Naukri Suvidha Test <test@example.test>"

# Left unset so the override assertion can test both branches.
# DEMO_EMAIL_OVERRIDE=
