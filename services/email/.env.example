# The email service. Copy to .env and fill in.
#
# Owns its own database for the EmailLog audit trail and the retry queue.
NODE_ENV=development
PORT=5005
LOG_LEVEL=debug
CLIENT_ORIGIN=http://localhost:5173

# Its own database. Never shares with any other service.
MONGODB_URI=mongodb://127.0.0.1:27017/naukri_suvidha_email

# Where to resolve student emails from. Unset for a dev run without auth; the
# handler then records 'skipped' rows rather than guessing.
AUTH_SERVICE_URL=http://localhost:5002
AUTH_SERVICE_TIMEOUT_MS=2000
AUTH_GATEWAY_SECRET=change-me-at-least-16-chars

# NOT optional in a deployment: this service is a pure consumer, and with no
# broker it hears nothing and sends nothing. Point it at the compose broker's
# host listener for a dev run:
#   docker compose up -d kafka
KAFKA_BROKERS=localhost:9094

# SMTP transport. Gmail requires a 2FA app password - not your real one. See
#   https://support.google.com/accounts/answer/185833
# A different provider (Mailtrap, SendGrid, Postfix) uses the same four fields.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM="Naukri Suvidha <you@gmail.com>"

# Demo-only. Every send is rewritten to this address during development, so a
# demo laptop can show an email arriving without needing real inboxes for the
# @naukrisuvidha.edu seed addresses. The EmailLog row still records the
# original recipient as `originalTo`.
# DEMO_EMAIL_OVERRIDE=you@yours.edu
